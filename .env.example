# Gmail credentials used to send notification mails (optional while developing locally)
EMAIL=
PASSWORD=

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/BlockVotes

# Blockchain RPC endpoint (local Ganache by default)
RPC_URL=http://127.0.0.1:8545

# Only needed when deploying to a public testnet (e.g. Sepolia Infura URL + funded mnemonic)
MNEMONIC=
